---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, other, alternatePath, path, type Lang, type PageKey } from '../lib/i18n';
import { siteUrl } from '../config';

interface Props {
  lang: Lang;
  page: PageKey;
  title?: string;
  description?: string;
  /** Code d'une entrée du référentiel, pour que le sélecteur de langue vise sa jumelle. */
  code?: string;
  accent?: string;
}

const { lang, page, title, description, code, accent = 'petrole' } = Astro.props;
const s = site(lang);
const pageTitle = title ? `${title} · ${s.meta.name}` : `${s.meta.name} — ${s.meta.tagline}`;
const pageDescription = description ?? s.meta.description;
const alternate = alternatePath(lang, page, code);
const self = Astro.url.pathname;

// La carte sociale est une image absolue ou rien : les robots des réseaux ne
// résolvent pas les chemins relatifs. Elle n'apparaît donc qu'une fois le nom
// de domaine arrêté, comme l'URL canonique.
const socialCard = lang === 'fr' ? '/carte-sociale.png' : '/carte-sociale-en.png';
const socialCardUrl = siteUrl ? new URL(socialCard, siteUrl).href : undefined;
---

<!doctype html>
<html lang={lang} data-accent={accent}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={s.meta.author} />
    <link rel="alternate" hreflang={lang} href={self} />
    <link rel="alternate" hreflang={other(lang)} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={path('fr', 'home')} />
    {siteUrl && <link rel="canonical" href={new URL(self, siteUrl).href} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={s.locale.replace('-', '_')} />
    <meta property="og:site_name" content={s.meta.name} />
    {
      socialCardUrl && (
        <>
          <meta property="og:image" content={socialCardUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={`${s.meta.name} — ${s.meta.subtitle}`} />
        </>
      )
    }
    <meta name="twitter:card" content={socialCardUrl ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fbf9f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131210" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Applique le thème avant le premier rendu : évite le clignotement clair/sombre.
      (() => {
        try {
          const saved = localStorage.getItem('creacomp-theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          }
        } catch {
          /* stockage indisponible : on garde la préférence système */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#contenu">{s.nav.skipToContent}</a>
    <Header lang={lang} page={page} code={code} />
    <main id="contenu">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
