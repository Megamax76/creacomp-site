---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site, type Lang } from '../lib/i18n';
import { web3formsKey, contactEmail } from '../config';
import { image, credit, creditSource } from '../lib/images';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = site(lang);
const c = s.contact;

// Un site statique n'a pas de serveur : sans relais configuré, aucun envoi ne
// peut partir d'ici. Le formulaire reste alors affiché, mais son bouton prépare
// le message dans la messagerie du visiteur — la page n'est jamais une impasse.
const key = web3formsKey.trim();
const configured = key.length > 0;
const endpoint = 'https://api.web3forms.com/submit';
const illustration = image('contact');
const illustrationCredit = credit('contact');
---

<Base lang={lang} page="contact" title={c.title} description={c.lead}>
  <section class="head">
    <div class="wrap">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1 class="head__title">{c.title}</h1>
      <p class="lead">{c.lead}</p>
    </div>
  </section>

  <div class="wrap">
      {
        illustration && (
          <figure class="illus">
            <div class="illus__frame">
              <Image
                src={illustration}
                alt={c.imageAlt}
                widths={[640, 1024, 1600]}
                sizes="(max-width: 78rem) 100vw, 78rem"
              />
            </div>
            {illustrationCredit && (
              <figcaption class="credit-line">
                <a href={illustrationCredit.authorUrl} rel="noopener noreferrer" target="_blank">
                  {illustrationCredit.author}
                </a>
                <span aria-hidden="true"> · </span>
                <a href={creditSource.url} rel="noopener noreferrer" target="_blank">
                  {creditSource.name}
                </a>
              </figcaption>
            )}
          </figure>
        )
      }
  </div>

  <div class="wrap layout">
    <section class="reasons">
      <h2 class="reasons__title">{c.reasons.title}</h2>
      <ul class="reasons__list">
        {
          c.reasons.items.map((item) => (
            <li class="reason">
              <h3 class="reason__name">{item.name}</h3>
              <p class="reason__body">{item.body}</p>
            </li>
          ))
        }
      </ul>

      <div class="direct">
        <p class="direct__label">{c.direct.title}</p>
        <p class="direct__body">{c.direct.body}</p>
        <a class="direct__mail" href={`mailto:${contactEmail}`}>{contactEmail}</a>
      </div>
    </section>

    <section class="formwrap">
      <h2 class="formwrap__title">{c.form.title}</h2>

      {!configured && <p class="form__note">{c.form.fallbackNote}</p>}

      <form
        class="form"
        action={configured ? endpoint : undefined}
        method="POST"
        data-contact-form
        data-relay={configured ? 'web3forms' : 'mailto'}
        data-mail-to={contactEmail}
        data-prefix={s.meta.name}
        data-sending={c.form.sending}
        data-success={c.form.success}
        data-failure={c.form.error.replace('{email}', contactEmail)}
      >
        {configured && <input type="hidden" name="access_key" value={key} />}

        <div class="field">
          <label for="name">{c.form.name}</label>
          <input type="text" id="name" name="name" required autocomplete="name" />
        </div>

        <div class="field">
          <label for="email">{c.form.email}</label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>

        <div class="field">
          <label for="organisation">{c.form.organisation}</label>
          <input type="text" id="organisation" name="organisation" autocomplete="organization" />
        </div>

        <div class="field">
          <label for="subject">{c.form.subject}</label>
          <select id="subject" name="subject" required>
            {c.form.subjectOptions.map((option) => (
              <option value={option}>{option}</option>
            ))}
          </select>
        </div>

        <div class="field">
          <label for="message">{c.form.message}</label>
          <textarea id="message" name="message" rows="7" required />
        </div>

        {/* Piège à robots : la case n'est ni visible, ni atteignable au clavier,
            ni annoncée aux lecteurs d'écran — seul un automate la coche. Web3Forms
            écarte alors l'envoi sans rien signaler, ce qui évite d'apprendre au
            robot à s'en passer. */}
        <input
          class="gotcha"
          type="checkbox"
          name="botcheck"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />

        <button class="btn" type="submit" data-submit>
          {configured ? c.form.submit : c.form.submitFallback}
        </button>

        <p class="form__status" role="status" aria-live="polite" tabindex="-1" data-status hidden></p>

        {configured && <p class="form__privacy">{c.form.privacy.replace('{email}', contactEmail)}</p>}
      </form>
    </section>
  </div>
</Base>

<script>
  // Ce script ne porte pas `is:inline` : Astro ne calcule d'empreinte SHA-256
  // que pour les scripts qu'il traite lui-même, et la politique de sécurité du
  // site bloque tout le reste. Les textes traduits arrivent donc par attributs
  // `data-` plutôt que par `define:vars`, qui imposerait `is:inline`.
  const form = document.querySelector('[data-contact-form]');

  if (form instanceof HTMLFormElement) {
    // Astro traite ce bloc comme du TypeScript et le compile avant de le servir :
    // les annotations ci-dessous disparaissent du script envoyé au navigateur.
    const status = form.querySelector('[data-status]') as HTMLElement;
    const submit = form.querySelector('[data-submit]') as HTMLButtonElement;
    const submitLabel = submit.textContent?.trim() ?? '';
    const settings = form.dataset;

    type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    const value = (name: string) => (form.elements.namedItem(name) as Field).value.trim();

    // Les intitulés vivent déjà dans les <label> : les relire évite d'entretenir
    // une seconde copie des traductions rien que pour le brouillon de courriel.
    const labelOf = (name: string) =>
      form.querySelector(`label[for="${name}"]`)?.textContent?.trim() ?? '';

    // L'objet du courrier reçu porte de quoi trier sans ouvrir : le nom du
    // référentiel, la raison choisie dans la liste, puis l'expéditeur.
    const subjectLine = () => `${settings.prefix} — ${value('subject')} — ${value('name')}`;

    const announce = (text: string, state: 'ok' | 'error') => {
      status.textContent = text;
      status.dataset.state = state;
      status.hidden = false;
      status.focus();
    };

    // Sans relais configuré, le navigateur reste le seul chemin possible : on
    // remet au visiteur un brouillon déjà rempli, à lui de l'expédier.
    const draftInMailClient = () => {
      const body = ['name', 'email', 'organisation', 'message']
        .map((name) => [labelOf(name), value(name)])
        .filter(([, written]) => written)
        .map(([label, written]) => `${label}\n${written}`)
        .join('\n\n');

      window.location.href =
        `mailto:${settings.mailTo}` +
        `?subject=${encodeURIComponent(subjectLine())}` +
        `&body=${encodeURIComponent(body)}`;
    };

    const relay = async () => {
      submit.disabled = true;
      submit.textContent = settings.sending ?? '';
      status.hidden = true;

      try {
        const data = new FormData(form);
        data.set('subject', subjectLine());
        data.set('from_name', value('name'));

        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        // Web3Forms répond 200 même lorsqu'il écarte l'envoi : c'est le drapeau
        // `success` du corps de la réponse qui fait foi, pas le code HTTP.
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.success) {
          throw new Error(result.message ?? String(response.status));
        }

        form.reset();
        announce(settings.success ?? '', 'ok');
      } catch {
        announce(settings.failure ?? '', 'error');
      } finally {
        submit.disabled = false;
        submit.textContent = submitLabel;
      }
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (settings.relay === 'mailto') draftInMailClient();
      else relay();
    });
  }
</script>

<style>
  .head {
    padding-block: clamp(2.8rem, 7vw, 5rem) clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--rule);
  }
  .head__title { font-size: var(--step-4); max-width: 16ch; margin-bottom: 1.1rem; }


  /* --- Illustration ------------------------------------------------------------- */

  .illus { margin: clamp(2.5rem, 6vw, 4rem) 0 clamp(2.5rem, 6vw, 4rem); }
  .illus__frame {
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 21 / 7;
    background: var(--paper-sunken);
  }
  @media (max-width: 46rem) {
    .illus__frame { aspect-ratio: 3 / 2; }
  }
  .illus__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.62) contrast(1.04);
  }
  .credit-line {
    margin-top: 0.55rem;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }
  .credit-line a { color: inherit; text-decoration: none; }
  .credit-line a:hover { color: var(--accent); text-decoration: underline; }

  .layout {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }
  @media (min-width: 62rem) {
    .layout { grid-template-columns: 1fr 1.1fr; }
  }

  .reasons__title,
  .formwrap__title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 1.3rem;
  }

  .reasons__list { list-style: none; display: grid; gap: 1.4rem; }
  .reason__name {
    font-size: 1.08rem;
    letter-spacing: -0.012em;
  }
  .reason__body {
    margin-top: 0.35rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .direct {
    margin-top: 2.2rem;
    padding: 1.3rem 1.4rem 1.5rem;
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--paper-sunken);
  }
  .direct__label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .direct__body {
    margin-top: 0.5rem;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .direct__mail {
    display: inline-block;
    margin-top: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent);
    text-decoration: none;
    word-break: break-all;
  }
  .direct__mail:hover { text-decoration: underline; }

  .form { display: grid; gap: 1.1rem; }
  .gotcha { display: none; }

  .form__note {
    margin-bottom: 1.3rem;
    padding: 0.75rem 0.95rem;
    border: 1px dashed var(--rule-strong);
    border-radius: var(--radius);
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .field { display: grid; gap: 0.4rem; }
  .field label {
    font-size: 0.84rem;
    color: var(--ink-soft);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.7rem 0.85rem;
    font: inherit;
    font-size: 0.93rem;
    color: var(--ink);
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .field textarea { resize: vertical; line-height: 1.6; }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible { border-color: var(--accent); }

  .form .btn { justify-self: start; margin-top: 0.4rem; }
  .form .btn[disabled] { opacity: 0.6; cursor: progress; transform: none; }

  .form__status {
    padding: 0.8rem 1rem;
    border-radius: var(--radius);
    font-size: 0.88rem;
    line-height: 1.55;
  }
  .form__status[data-state='ok'] {
    background: var(--accent-wash);
    border: 1px solid var(--accent-edge);
    color: var(--ink);
  }
  .form__status[data-state='error'] {
    background: var(--paper-sunken);
    border: 1px solid var(--rule-strong);
    color: var(--ink-soft);
  }

  .form__privacy {
    font-size: 0.76rem;
    line-height: 1.6;
    color: var(--ink-faint);
  }
</style>
