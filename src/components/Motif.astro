---
/**
 * Motif géométrique d'une rubrique ou d'un fil transversal.
 *
 * Dessiné en SVG plutôt que photographié : sept marques abstraites, tracées
 * dans l'encre de la rubrique, tiennent le registre sobre d'un référentiel
 * académique là où sept photographies feraient illustration. La teinte vient
 * de `--accent`, donc elle suit la rubrique et le thème sans réglage.
 */

interface Props {
  /** « rubrique-3 », « fil-t2 »… */
  motifKey: string;
  /**
   * Décline la figure sans la faire changer de famille : passer le code d'une
   * compétence (« 1.1 ») donne à sa page une silhouette qui n'appartient qu'à
   * elle, tracée dans la même figure et la même encre que sa rubrique. Absent,
   * la figure de référence est rendue à l'identique.
   */
  variant?: string;
  ratio?: string;
  class?: string;
}

const { motifKey, variant, ratio = '1 / 1', class: className = '' } = Astro.props;
const uid = `m-${motifKey}-${Math.random().toString(36).slice(2, 8)}`;

/** Empreinte stable d'un code : la même compétence donne toujours le même dessin. */
function fingerprint(input: string): number {
  let value = 2166136261;
  for (let i = 0; i < input.length; i += 1) {
    value ^= input.charCodeAt(i);
    value = Math.imul(value, 16777619);
  }
  // Décalé de 1 : la graine nulle reste réservée à la figure de référence.
  return ((value >>> 0) % 9973) + 1;
}

const seed = variant ? fingerprint(`${motifKey}-${variant}`) : 0;

/** Suite déterministe : les motifs doivent être identiques d'une page à l'autre. */
function series(count: number, seed: number): number[] {
  const out: number[] = [];
  let value = seed;
  for (let i = 0; i < count; i += 1) {
    value = (value * 1103515245 + 12345) % 2147483648;
    out.push(value / 2147483648);
  }
  return out;
}

type Shape = { d?: string; cx?: number; cy?: number; r?: number; x?: number; y?: number;
               w?: number; h?: number; fill?: boolean; opacity: number; width?: number;
               rotate?: number };

/**
 * Chaque rubrique reçoit une figure qui dit ce qu'elle fait. La graine ne change
 * jamais la figure, seulement son allure : espacement, amplitude, inclinaison.
 * Une graine nulle rend la figure de référence au trait près.
 */
function shapesFor(key: string, seed: number): Shape[] {
  // Écarts centrés sur zéro, donc sans effet tant qu'aucune variante n'est demandée.
  const v = seed === 0 ? [0, 0, 0, 0, 0, 0] : series(6, seed).map((n) => n - 0.5);

  switch (key) {
    // S'informer — des strates : les couches de sources que l'on empile.
    case 'rubrique-1':
      return series(9, 11 + seed).map((n, i) => ({
        x: 12 + v[1] * 9, y: 14 + i * (9 + v[0] * 1.6), w: 30 + n * 58, h: 3.4,
        fill: true, opacity: 0.85 - i * 0.07,
      }));

    // Analyser — une trame de signaux, plus dense là où le système mesure.
    case 'rubrique-2': {
      const dots: Shape[] = [];
      // Incline la pente de densité sans jamais la faire disparaître.
      const tilt = 1 + v[0] * 0.7;
      for (let row = 0; row < 8; row += 1) {
        for (let col = 0; col < 8; col += 1) {
          const t = (row * tilt + col * (2 - tilt)) / 14;
          dots.push({
            cx: 14 + v[1] * 5 + col * 10.5, cy: 14 + v[2] * 5 + row * 10.5,
            r: 1.1 + (1 - t) * 3, fill: true, opacity: 0.25 + (1 - t) * 0.6,
          });
        }
      }
      return dots;
    }

    // Créer — une émanation : des arcs qui partent d'un même point.
    case 'rubrique-3': {
      const step = 14 + v[0] * 3;
      const origin = 8 + v[1] * 9;
      return [1, 2, 3, 4, 5, 6, 7].map((rank, i) => {
        const r = rank * step;
        return {
          d: `M ${origin + r} 100 A ${r} ${r} 0 0 0 ${origin} ${100 - r}`,
          width: 2.6, opacity: 0.82 - i * 0.1,
        };
      });
    }

    // Faire — une cadence de production, lue comme une onde.
    case 'rubrique-4':
      return series(14, 29 + seed).map((n, i) => {
        const h = 14 + n * 62;
        return {
          x: 11 + i * (6.4 + v[0] * 0.45), y: 88 - h, w: 3.6, h,
          fill: true, opacity: 0.35 + n * 0.5,
        };
      });

    // Collaborer — des cercles qui se recouvrent : les liens entre pairs.
    case 'rubrique-5':
      return [
        { cx: 38, cy: 40, r: 24 }, { cx: 62, cy: 40, r: 24 },
        { cx: 50, cy: 62, r: 24 }, { cx: 30, cy: 66, r: 17 },
        { cx: 70, cy: 66, r: 17 },
      ].map((c, i) => ({
        cx: c.cx + v[i % 6] * 9,
        cy: c.cy + v[(i + 2) % 6] * 7,
        r: c.r + v[(i + 1) % 6] * 3.5,
        width: 2.4, opacity: 0.75 - i * 0.09,
      }));

    // Entreprendre — une élévation : le projet qui se construit par paliers.
    case 'rubrique-6': {
      const rise = 15 + v[1] * 2.5;
      return [0, 1, 2, 3, 4].map((i) => ({
        x: 12 + i * (16 + v[0] * 1.2), y: 82 - i * rise, w: 13, h: 6 + i * rise,
        fill: true, opacity: 0.35 + i * 0.13,
      }));
    }

    // Rentabiliser — une accumulation : les actifs qui se déposent en couches.
    case 'rubrique-7':
      return [0, 1, 2, 3, 4, 5].map((i) => ({
        x: 14 + i * (2.5 + v[0] * 2.2), y: 84 - i * (12 + v[1] * 1.6),
        w: 72 - i * (5 + v[2] * 3), h: 8,
        fill: true, opacity: 0.3 + i * 0.11,
      }));

    // Discerner — une ligne de partage nette entre ce qu'on fait et ce qu'on refuse.
    case 'fil-t1':
      return [
        { d: 'M 6 94 L 94 6', width: 3, opacity: 0.85 },
        ...series(7, 71 + seed).map((n, i) => ({
          d: `M ${14 + i * 11} 92 L ${34 + i * 11 + n * 8} ${72 - i * 8}`,
          width: 1.6, opacity: 0.5 - i * 0.05,
        })),
      ];

    // Durer — une onde longue, régulière, qui ne s'épuise pas.
    case 'fil-t2': {
      const amplitude = 18 + v[1] * 7;
      return [0, 1, 2, 3].map((i) => {
        const y = 28 + i * (16 + v[0] * 2);
        return {
          d: `M 4 ${y} C 28 ${y - amplitude}, 44 ${y + amplitude}, 68 ${y} S 96 ${y - amplitude}, 96 ${y}`,
          width: 2.4, opacity: 0.8 - i * 0.16,
        };
      });
    }

    // Se réinventer — un même carré, repris sous un autre angle.
    case 'fil-t3': {
      const growth = 7 + v[0] * 1.5;
      const turn = 9 + v[1] * 6;
      return [0, 1, 2, 3, 4].map((i) => {
        const half = 16 + i * growth;
        return {
          d: `M 50 50 m -${half} -${half} h ${half * 2} v ${half * 2} h -${half * 2} Z`,
          width: 2.2, opacity: 0.8 - i * 0.14,
          rotate: i * turn,
        };
      });
    }

    default:
      return [];
  }
}

const shapes = shapesFor(motifKey, seed);
---

<div class:list={['motif', className]} data-ratio={ratio} aria-hidden="true">
  <svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice" role="presentation">
    <defs>
      <linearGradient id={uid} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.22" />
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.05" />
      </linearGradient>
    </defs>

    <rect width="100" height="100" fill={`url(#${uid})`} />

    <g stroke="var(--accent)" fill="none" stroke-linecap="round">
      {
        shapes.map((shape) => {
          const common = {
            opacity: shape.opacity,
            ...(shape.rotate ? { transform: `rotate(${shape.rotate} 50 50)` } : {}),
          };
          if (shape.d) {
            return <path d={shape.d} stroke-width={shape.width} {...common} />;
          }
          if (shape.r !== undefined) {
            return shape.fill ? (
              <circle cx={shape.cx} cy={shape.cy} r={shape.r} fill="var(--accent)" stroke="none" {...common} />
            ) : (
              <circle cx={shape.cx} cy={shape.cy} r={shape.r} stroke-width={shape.width} {...common} />
            );
          }
          return (
            <rect
              x={shape.x}
              y={shape.y}
              width={shape.w}
              height={shape.h}
              fill="var(--accent)"
              stroke="none"
              {...common}
            />
          );
        })
      }
    </g>
  </svg>
</div>

<style>
  /* Les proportions passent par un attribut plutôt que par un style en ligne :
     la politique de sécurité du contenu interdit les attributs `style`. */
  .motif {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper-raised);
    border: 1px solid var(--rule);
  }
  .motif[data-ratio='16 / 6'] { aspect-ratio: 16 / 6; }
  .motif[data-ratio='16 / 5'] { aspect-ratio: 16 / 5; }
  .motif svg { width: 100%; height: 100%; display: block; }
</style>
