---
/**
 * La marque CreaComp — un obturateur à six lames refermé sur un C.
 *
 * Les six lames portent les rubriques 2 à 7 ; la première, S'informer, n'est
 * pas une lame : c'est l'ouverture elle-même, et c'est elle qui porte le C.
 *
 * Le symbole est écrit en clair dans la page plutôt que chargé comme image :
 * il n'ajoute aucune requête, et ses couleurs sont celles des variables du
 * thème, donc il suit la bascule clair/sombre sans second fichier. Les tracés
 * viennent de `brand/traces.json`, refabriqué par `scripts/logo/construire.py`.
 *
 * Le C reste en pétrole en toute circonstance : c'est un logo, il ne se
 * recolore pas avec l'accent de la page.
 */

interface Props {
  /** Nom accessible. Absent, le symbole est décoratif — le cas courant, le nom
   *  étant alors écrit à côté en toutes lettres. */
  title?: string;
  class?: string;
}

const { title, class: className } = Astro.props;

const lames = [
  'M51.07 3.01A47 47 0 0 1 90.16 25.58L83.93 52.19L70.13 22.60Z',
  'M91.23 27.43A47 47 0 0 1 91.23 72.57L65.06 80.48L83.79 53.73Z',
  'M90.16 74.42A47 47 0 0 1 51.07 96.99L31.14 78.29L63.67 81.13Z',
  'M48.93 96.99A47 47 0 0 1 9.84 74.42L16.07 47.81L29.87 77.40Z',
  'M8.77 72.57A47 47 0 0 1 8.77 27.43L34.94 19.52L16.21 46.27Z',
  'M9.84 25.58A47 47 0 0 1 48.93 3.01L68.86 21.71L36.33 18.87Z',
];
const c = 'M63.17 24.15A28.49 28.49 0 1 0 63.17 75.85L63.17 60.60A15.99 15.99 0 1 1 63.17 39.40Z';
---

<svg
  class:list={['logo', className]}
  viewBox="0 0 100 100"
  role={title ? 'img' : 'presentation'}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>
  {lames.map((d, i) => <path class={`logo__lame logo__lame--${i + 2}`} d={d} />)}
  <path class="logo__c" d={c} />
</svg>

<style>
  .logo {
    width: 1em;
    height: 1em;
    flex: none;
  }

  /* Numérotées d'après la rubrique qu'elles portent, non d'après leur rang. */
  .logo__lame--2 { fill: var(--indigo); }
  .logo__lame--3 { fill: var(--carmin); }
  .logo__lame--4 { fill: var(--terre); }
  .logo__lame--5 { fill: var(--foret); }
  .logo__lame--6 { fill: var(--sarcelle); }
  .logo__lame--7 { fill: var(--bronze); }
  .logo__c { fill: var(--petrole); }

  /* En dessous de 24 px, six teintes se brouillent : le symbole se replie sur
     une seule encre, qui reste nette jusqu'à 16 px. */
  .logo--menu .logo__lame,
  .logo--menu .logo__c { fill: var(--petrole); }
</style>
