---
interface Props {
  value: string;
  label: string;
  copiedLabel: string;
}

const { value, label, copiedLabel } = Astro.props;
---

<button class="copy" type="button" data-copy data-value={value} data-copied={copiedLabel}>
  <span class="copy__icons" aria-hidden="true">
    <svg class="copy__icon copy__icon--idle" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7">
      <rect x="9" y="9" width="11" height="11" rx="2" />
      <path d="M5 15V6a2 2 0 0 1 2-2h9" stroke-linecap="round" />
    </svg>
    <svg class="copy__icon copy__icon--done" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4.5 12.5 9.5 17.5 19.5 6.5" />
    </svg>
  </span>
  <span data-copy-label>{label}</span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const label = button.querySelector('[data-copy-label]');
    const initial = label?.textContent ?? '';

    button.addEventListener('click', async () => {
      const value = button.dataset.value ?? '';
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        // Presse-papiers refusé (contexte non sécurisé, permission) : on sélectionne
        // le texte dans un champ temporaire pour que l'utilisateur copie lui-même.
        const field = document.createElement('textarea');
        field.value = value;
        field.setAttribute('readonly', '');
        field.style.position = 'fixed';
        field.style.opacity = '0';
        document.body.append(field);
        field.select();
        document.execCommand('copy');
        field.remove();
      }
      if (!label) return;
      label.textContent = button.dataset.copied ?? initial;
      button.dataset.state = 'done';
      setTimeout(() => {
        label.textContent = initial;
        delete button.dataset.state;
      }, 2000);
    });
  });
</script>

<style>
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--ink-soft);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, transform 0.14s ease-out;
  }
  .copy:hover { color: var(--accent); border-color: var(--accent); }
  .copy:active { transform: scale(0.985); }
  .copy[data-state='done'] { color: var(--accent); border-color: var(--accent); }

  /* La confirmation ne tenait qu'au libellé : le pictogramme restait un
     presse-papiers pendant qu'on lisait « Copié ». Les deux icônes sont
     superposées dans une case de taille fixe — rien ne bouge autour — et
     s'échangent par un fondu court. C'est un geste rare, donc il a droit à
     une coche. */
  .copy__icons { display: grid; width: 14px; height: 14px; flex: none; }
  .copy__icon {
    grid-area: 1 / 1;
    transition: opacity 0.16s ease-out, transform 0.16s ease-out;
  }
  .copy__icon--done { opacity: 0; transform: scale(0.7); }
  .copy[data-state='done'] .copy__icon--idle { opacity: 0; transform: scale(0.7); }
  .copy[data-state='done'] .copy__icon--done { opacity: 1; transform: none; }
</style>
