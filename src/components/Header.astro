---
import { site, path, alternatePath, type Lang, type PageKey } from '../lib/i18n';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
  page: PageKey;
  code?: string;
}

const { lang, page, code } = Astro.props;
const s = site(lang);

const links: { key: PageKey; label: string }[] = [
  { key: 'framework', label: s.nav.framework },
  { key: 'foundations', label: s.nav.foundations },
  { key: 'use', label: s.nav.use },
  { key: 'contact', label: s.nav.contact },
];
---

<header class="masthead">
  <div class="masthead__inner wrap">
    <a class="brand" href={path(lang, 'home')}>
      <span class="brand__mark"><Logo /></span>
      <span class="brand__name">CréaComp</span>
      <span class="visually-hidden">{s.meta.subtitle}</span>
    </a>

    <input type="checkbox" id="menu-toggle" class="menu-state" />
    <label for="menu-toggle" class="menu-button">
      <span class="visually-hidden">{s.nav.menu}</span>
      <span class="menu-button__bars" aria-hidden="true"></span>
    </label>

    <nav class="nav" aria-label={s.nav.menu}>
      <ul class="nav__list">
        {
          links.map((link) => (
            <li>
              <a
                href={path(lang, link.key)}
                aria-current={page === link.key ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav__tools">
        <a class="lang-switch" href={alternatePath(lang, page, code)} lang={lang === 'fr' ? 'en' : 'fr'}>
          {s.nav.switchLang}
        </a>
        <button class="theme-toggle" type="button" data-theme-toggle>
          <span class="visually-hidden">{s.nav.theme}</span>
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2.4v2.3M12 19.3v2.3M2.4 12h2.3M19.3 12h2.3M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const current = () =>
    root.dataset.theme ??
    (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('creacomp-theme', next);
    } catch {
      /* stockage indisponible : le choix vaut pour la session */
    }
  });

  // Referme le menu mobile après une navigation par ancre.
  const state = document.getElementById('menu-toggle') as HTMLInputElement | null;
  document.querySelectorAll('.nav__list a').forEach((link) =>
    link.addEventListener('click', () => {
      if (state) state.checked = false;
    }),
  );
</script>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid var(--rule);
  }

  .masthead__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 4.4rem;
  }

  /* Une seule ligne : le symbole porte l'identité, le mot la nomme. La ligne de
     définition a quitté le bandeau — elle est dans le titre de la page et dans
     le pied — pour que l'en-tête reste léger et laisse la place au contenu. */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.62rem;
    text-decoration: none;
    padding-block: 0.7rem;
  }
  /* Le symbole se dimensionne en `em` : sa taille tient dans cette seule règle. */
  .brand__mark {
    display: flex;
    font-size: 2rem;
  }
  .brand__name {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 20, 'WONK' 1, 'opsz' 20;
    font-size: 1.32rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.4rem);
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2.2vw, 1.9rem);
    list-style: none;
  }
  .nav__list a {
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--ink-soft);
    padding-block: 0.35rem;
    border-bottom: 1.5px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .nav__list a:hover { color: var(--ink); }
  .nav__list a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .nav__tools {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-left: clamp(0.5rem, 2vw, 1.4rem);
    border-left: 1px solid var(--rule);
  }

  .lang-switch {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-soft);
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .lang-switch:hover { color: var(--accent); border-color: var(--accent); }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--ink-soft);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .theme-toggle:hover { color: var(--accent); border-color: var(--rule); }

  .menu-state,
  .menu-button { display: none; }

  @media (max-width: 62rem) {
    .menu-state {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .menu-button {
      display: grid;
      place-items: center;
      width: 2.6rem;
      height: 2.6rem;
      cursor: pointer;
      border: 1px solid var(--rule);
      border-radius: var(--radius);
    }
    .menu-button__bars,
    .menu-button__bars::before,
    .menu-button__bars::after {
      content: '';
      display: block;
      width: 1.05rem;
      height: 1.5px;
      background: currentColor;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .menu-button__bars::before { transform: translateY(-5px); }
    .menu-button__bars::after { transform: translateY(3.5px); }

    .nav {
      position: absolute;
      inset: 100% 0 auto;
      display: grid;
      gap: 0;
      background: var(--paper);
      border-bottom: 1px solid var(--rule);
      padding: 0 var(--gutter);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.24s ease;
    }
    .menu-state:checked ~ .nav { max-height: 26rem; }

    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-top: 0.5rem;
    }
    .nav__list a {
      display: block;
      padding: 0.85rem 0;
      border-bottom: 1px solid var(--rule);
      font-size: 1.02rem;
    }
    .nav__list a[aria-current='page'] { border-bottom-color: var(--accent); }

    .nav__tools {
      padding: 1rem 0 1.4rem;
      border-left: 0;
    }
  }
</style>
