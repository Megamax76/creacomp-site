---
import Competence from '../../../views/Competence.astro';
import { entries } from '../../../lib/i18n';

export function getStaticPaths() {
  return entries('en').map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<Competence lang="en" entry={entry} />
