---
import Base from '../layouts/Base.astro';
import { site, path } from '../lib/i18n';

const fr = site('fr');
const en = site('en');
---

<Base lang="fr" page="home" title={fr.notFound.title} description={fr.notFound.body}>
  <section class="lost">
    <div class="wrap lost__inner">
      <p class="lost__code" aria-hidden="true">404</p>

      <div class="lost__block" lang="fr">
        <h1 class="lost__title">{fr.notFound.title}</h1>
        <p class="lost__body">{fr.notFound.body}</p>
        <a class="btn" href={path('fr', 'home')}>{fr.notFound.cta}</a>
      </div>

      <div class="lost__block" lang="en">
        <h2 class="lost__title">{en.notFound.title}</h2>
        <p class="lost__body">{en.notFound.body}</p>
        <a class="btn btn--ghost" href={path('en', 'home')}>{en.notFound.cta}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost { padding-block: clamp(4rem, 12vw, 9rem); }
  .lost__inner { max-width: 46rem; }
  .lost__code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--accent);
    margin-bottom: 2rem;
  }
  .lost__block + .lost__block {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--rule);
  }
  .lost__title { font-size: var(--step-3); }
  .lost__body {
    margin: 0.8rem 0 1.6rem;
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
</style>
